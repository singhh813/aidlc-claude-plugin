{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/aidlc-gate-guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/aidlc-gate-guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/aidlc-gate-guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/aidlc-gate-guard.py\""
          }
        ]
      }
    ]
  }
}
